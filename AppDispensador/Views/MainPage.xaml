<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppDispensador.ViewModels"
             xmlns:models="clr-namespace:AppDispensador.Models"
             x:Class="AppDispensador.Views.MainPage"
             BackgroundColor="#121212"
             Title="Alarmas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <HorizontalStackLayout Grid.Row="0" Padding="15" Spacing="10" HorizontalOptions="End">
            <Ellipse WidthRequest="10" HeightRequest="10">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#CF6679" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="#03DAC6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Label VerticalOptions="Center">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="Text" Value="Desconectado" />
                        <Setter Property="TextColor" Value="#CF6679" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Text" Value="Conectado" />
                                <Setter Property="TextColor" Value="#03DAC6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Schedules}" Margin="10">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="No tienes horarios programados." 
                           TextColor="Gray" 
                           FontSize="16" 
                           HorizontalTextAlignment="Center" />
                    <Label Text="Toca + para agregar uno" 
                           TextColor="Gray" 
                           FontSize="14" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Schedule">
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="15" Margin="0,5,0,5" Padding="20" BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EditScheduleCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding ActiveDays}" TextColor="LightGray" FontSize="14" />

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5" VerticalOptions="End">
                                <Label Text="{Binding DisplayTime}" TextColor="White" FontSize="45" FontAttributes="Bold" />
                                <Label Text="a.m." TextColor="LightGray" FontSize="16" VerticalOptions="End" Margin="0,0,0,8" />
                            </HorizontalStackLayout>

                            <Switch Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                                    IsToggled="{Binding IsActive}" 
                                    OnColor="#6650a4" 
                                    VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" Padding="15" ColumnDefinitions="*, Auto">
            <Button Grid.Column="0" 
                    Text="Dispensar ahora" 
                    Command="{Binding DispenseNowCommand}"
                    BackgroundColor="#6650a4" 
                    TextColor="White" 
                    CornerRadius="25"
                    HeightRequest="50"
                    Margin="0,0,15,0"/>

            <Button Grid.Column="1" 
                    Text="+" 
                    Command="{Binding NavigateToAddScheduleCommand}"
                    FontSize="24"
                    BackgroundColor="#8573b0"
                    TextColor="White"
                    CornerRadius="25"
                    WidthRequest="60"
                    HeightRequest="60"
                    VerticalOptions="End"/>
        </Grid>
    </Grid>
</ContentPage>